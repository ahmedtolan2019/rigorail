{
  "name": "react-ai-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run check:fast && npm run check:tooling && npm test && npm run build:demo && npm run check:bundle && npm run check:production",
    "catalog": "node scripts/catalog.mjs",
    "check:architecture": "node --test scripts/architecture.test.mjs && node scripts/architecture.mjs",
    "check:catalog": "node scripts/catalog.mjs --check",
    "build:demo": "tsc -b && vite build --mode demo",
    "format": "prettier --write src scripts tests *.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:fast": "npm run lint && npm run check:architecture && npm run check:catalog && npm run check:api && npm run typecheck",
    "context": "node scripts/context.mjs",
    "module:create": "node scripts/create-module.mjs",
    "module:remove": "node scripts/remove-module.mjs",
    "api:types": "node scripts/api-types.mjs",
    "check:api": "node scripts/api-types.mjs --check",
    "check:tooling": "node --test scripts/context.test.mjs scripts/hooks.test.mjs scripts/remove-module.test.mjs scripts/create-module.test.mjs",
    "check:production": "node scripts/check-production.mjs",
    "check:dependencies": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.7.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-resizable-panels": "^4.18.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "minimatch@>=10.0.0 <11.0.0": "11.0.4"
  },
  "license": "MIT"
}
